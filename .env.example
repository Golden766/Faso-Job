SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_POSTGRES=False
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DB_NAME=plateforme_offres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Supabase configuration
# 1. Copy this file to .env.
# 2. Set USE_POSTGRES=True when you want to use a remote Postgres database.
# 3. Replace the DATABASE_URL value with your Supabase connection string when ready.
# 4. Run: python manage.py migrate

# --- Double authentification et notifications -------------------------------
# L adresse utilisee comme expediteur des notifications internes.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-adresse@gmail.com
# Mot de passe d application Google (16 caracteres) :
# https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=votre-adresse@gmail.com

# --- Veille automatisee : service d intelligence artificielle -----------
# Ces reglages servent a la veille, qui analyse les annonces trouvees.
# La cle reste dans ce fichier, jamais dans le depot ni dans un gabarit.
#
# L adresse doit pointer vers un service compatible avec l interface
# OpenAI (endpoint /chat/completions). Les modeles gratuits utiles :
#
#   Gemini (Google AI Studio)
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.0-flash-exp
#
#   OpenRouter (modeles gratuits : "free" dans le nom)
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=deepseek/deepseek-chat-v3-0324:free
#
# Changer de modele ne demande qu une modification de AI_MODEL ici :
# le code suit.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Delai maximal d attente du service, en secondes.
AI_REQUEST_TIMEOUT=60
# A activer seulement si le service sait rendre un JSON strict.
AI_JSON_MODE=False
# --- Recherche sur le web (assistant de decouverte) ------------------------
# Facultatif. Sans ces reglages, l assistant s appuie sur les adresses
# que le modele propose. Avec eux, il elargit sa recherche.
#
# Brave Search (inscription gratuite sur brave.com/search/api) :
BRAVE_SEARCH_API_KEY=
# SearXNG (auto-heberge, gratuit) :
SEARXNG_URL=